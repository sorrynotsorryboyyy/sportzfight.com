{
  "name": "sportzfight.com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "emu": "firebase emulators:start --only firestore,auth --project demo-sportzfight",
    "test": "vitest run tests/machine.test.ts tests/pushup.test.ts tests/scoresync.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-sportzfight \"vitest run tests/rules.test.ts\"",
    "test:e2e": "vitest run tests/e2e-flow.test.ts",
    "test:all": "firebase emulators:exec --only firestore,auth --project demo-sportzfight \"vitest run\"",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "setup:mediapipe": "node scripts/setup-mediapipe.mjs",
    "postinstall": "node scripts/setup-mediapipe.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "firebase": "^12.18.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "firebase-tools": "^15.28.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
