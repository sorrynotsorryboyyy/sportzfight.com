rules_version = '2';

// ===================================================================
// SportzFight security rules — the trust boundary.
//
// There is no server code (Spark plan, no Cloud Functions), so THESE RULES
// are the only thing standing between a modified client and a forged result.
// The design principle: a client may report its OWN effort, but may never
// assert an outcome. The winner is recomputed here from committed scores.
//
// Timing constants mirror src/lib/battle/constants.ts. Keep them in sync.
// ===================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    /**
     * Real, server-enforced admin.
     *
     * Custom claims would need Cloud Functions, but a rule can simply READ the
     * role off the user document — the same get() this file already uses for
     * battles and receipts. Comments elsewhere used to claim admin could not be
     * enforced at all; that was wrong, and this is the correction.
     *
     * One memoised document read per evaluation.
     */
    function isAdmin() {
      return signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid))
               .data.get('role', '') == 'admin';
    }

    // ---- timing contract (must match src/lib/battle/constants.ts) ----
    function countdownSecs()  { return 3; }
    function scoreGraceSecs() { return 2; }
    function finishSlackSecs(){ return 2; }
    function staleSecs()      { return 15; }
    function maxScore()       { return 200; }
    function maxJump()        { return 40; }
    function staleLiveSecs()  { return 300; }   // 5 min
    function abandonWaitSecs(){ return 3600; }  // 1 h

    // ---- award contract (must match src/lib/progression/awards.ts) ----
    // A mismatch here does not throw: it silently denies every credit write
    // and players stop earning anything at all.
    function xpWin()    { return 100; }
    function xpDraw()   { return 60; }
    function xpLoss()   { return 40; }
    function xpPerRep() { return 2; }
    function coinsWin() { return 3; }
    function coinsDraw(){ return 2; }
    function coinsLoss(){ return 1; }
    function prBonus()  { return 10; }

    // ---- daily bonus contract (also mirrors awards.ts) ----
    function dailyGoalCoins()   { return 5; }
    function dailyGoalBattles() { return 3; }
    function streak3Coins()     { return 10; }
    function streak7Coins()     { return 40; }
    // A "day" is a rolling window, not a calendar date: rules have no timezone,
    // and a UTC midnight falls mid-evening in France.
    function streakWindowSecs() { return 72000; }   // 20 h
    function streakGraceSecs()  { return 172800; }  // 48 h

    /** What the nth consecutive day pays. Must match bonusForStreak(). */
    function streakBonus(n) {
      return dailyGoalCoins()
           + (n % 3 == 0 ? streak3Coins() : 0)
           + (n % 7 == 0 ? streak7Coins() : 0);
    }

    // ---- onboarding contract (must match src/lib/profile/onboarding.ts) ----
    // A drift here does not throw: it silently denies every onboarding write.
    function birthYearMin() { return 1920; }
    function heightMinCm()  { return 100; }
    function heightMaxCm()  { return 250; }
    function weightMinKg()  { return 25; }
    function weightMaxKg()  { return 300; }
    function cityMax()      { return 60; }

    // ---- reading a finished battle to verify a stat claim ----
    // These cost one document read per rule evaluation, but Firestore memoises
    // identical get() paths within a single evaluation, so a settle that calls
    // several of them still pays for one.
    function battleOf(bid) {
      return get(/databases/$(database)/documents/battles/$(bid)).data;
    }
    function battleExists(bid) {
      return exists(/databases/$(database)/documents/battles/$(bid));
    }
    /** A battle that actually concluded between two players. */
    function creditableBattle(bid, uid) {
      return battleExists(bid)
          && battleOf(bid).status == 'finished'
          && battleOf(bid).player2 != null
          && uid in battleOf(bid).players;
    }
    function repsOf(bid, uid) {
      return uid == battleOf(bid).player1
               ? battleOf(bid).player1Score
               : battleOf(bid).player2Score;
    }
    function wonBy(bid, uid)  { return battleOf(bid).winner == uid; }
    /** A win over a real account — the bot seat is the literal 'bot'. */
    function humanWinOf(bid, uid) {
      return battleOf(bid).winner == uid && battleOf(bid).player2 != 'bot';
    }
    function drawnBy(bid)     { return battleOf(bid).winner == 'draw'; }
    function xpAward(bid, uid) {
      return (drawnBy(bid) ? xpDraw() : wonBy(bid, uid) ? xpWin() : xpLoss())
           + repsOf(bid, uid) * xpPerRep();
    }
    function coinAward(bid, uid) {
      return drawnBy(bid) ? coinsDraw() : wonBy(bid, uid) ? coinsWin() : coinsLoss();
    }

    // ===============================================================
    // USERS — profile, verified progression counters, username lock
    // ===============================================================
    match /users/{userId} {
      function isSelf() { return signedIn() && request.auth.uid == userId; }
      function u()      { return resource.data; }
      function nu()     { return request.resource.data; }
      function touched(){ return nu().diff(u()).affectedKeys(); }

      /** Counter value before the write; absent counts as 0 on older docs. */
      function was(f)   { return u().get(f, 0); }
      function now_(f)  { return nu().get(f, 0); }
      function bumped(f, by) { return now_(f) == was(f) + by; }

      // The charset is enforced HERE, so it is a real server-side guarantee.
      // Profanity is deliberately NOT attempted: rules cannot hold a wordlist,
      // and pretending otherwise would be a lie. That filter is client-side.
      function validUsername(name) {
        return name is string
            && name.matches('^[a-zA-Z][a-zA-Z0-9_]{2,15}$');
      }

      // A single profile stays readable: the battle screen needs the opponent's
      // name and avatar, and the client reads its own role here.
      allow get: if signedIn();

      // LISTING is the leaderboard, and it is the dangerous verb: it lets any
      // signed-in client page the whole collection. It is only safe because
      // this document no longer holds an email address — that moved to the
      // owner-only private/ subcollection. DO NOT put PII back on this doc.
      allow list: if signedIn();

      // ---------------- CREATE ----------------
      // Counters are absent at creation and read as zero. 'role' and 'level'
      // are excluded: a client can neither mint itself an admin nor invent a
      // level, which is derived from xp and never stored.
      allow create: if isSelf()
                    && nu().keys().hasOnly(['username', 'avatar', 'createdAt'])
                    && validUsername(nu().username)
                    && nu().createdAt == request.time;

      // ---------------- PROFILE UPDATE ----------------
      // Rules validate the POST-WRITE document, not the diff. Accounts seeded
      // from a Google display name ("Léo Chevalier" — space and accent) predate
      // the charset. Without this grandfather clause such a user could never
      // change their avatar and — fatally — could never submit the rename that
      // fixes the name. So validate the username only when it actually changes.
      // Remove the clause once every stored name is compliant.
      function usernameUnchanged() {
        return !('username' in touched());
      }
      /**
       * Avatar only.
       *
       * `username` used to be writable here, and that was a real hole: the
       * rule checked the CHARSET but never the lock, so a modified client
       * could display a name reserved by somebody else and the leaderboard
       * would show two identical players. Rules cannot close it — they have no
       * toLower(), so they cannot derive a username's lock key.
       *
       * Renaming now goes through /api/username, which holds the lock and the
       * profile in one Admin SDK transaction.
       */
      function validProfileUpdate() {
        return touched().hasOnly(['avatar'])
            && (nu().avatar == null || nu().avatar is string);
      }

      /**
       * The onboarding answers a player may set themselves.
       *
       * accountType is capped at 'player' here: becoming a 'pro' is an
       * application an admin approves, so letting a client write it would be a
       * way straight into the partner programme.
       */
      function validOnboarding() {
        return touched().hasOnly(['accountType', 'experience', 'goal',
                                  'onboardedAt'])
            && (!('accountType' in nu()) || nu().accountType == 'player')
            && (!('experience' in nu())
                  || nu().experience in ['beginner', 'intermediate', 'advanced'])
            && (!('goal' in nu())
                  || nu().goal in ['restart', 'progress', 'compete', 'fun'])
            // Write-once and server-stamped: the welcome screen must not be
            // re-armed, and its date must be real.
            && (!('onboardedAt' in nu())
                  || (u().get('onboardedAt', null) == null
                        && nu().onboardedAt == request.time));
      }

      // ---------------- PHASE 1: claim a finished battle ----------------
      // Sets pendingBattleId and nothing else. The receipt check is what makes
      // replaying one battle to farm XP impossible: rules cannot see other
      // writes in the same batch, but they CAN see previously committed state.
      function validClaim() {
        return touched().hasOnly(['pendingBattleId'])
            && nu().pendingBattleId is string
            && creditableBattle(nu().pendingBattleId, userId)
            && !exists(/databases/$(database)/documents/users/$(userId)/creditedBattles/$(nu().pendingBattleId));
      }

      // ---------------- PHASE 2: settle the claimed battle ----------------
      // Every counter must move by exactly the amount derived from the battle
      // document itself, so a client can neither claim a win it lost nor
      // inflate its reps. The receipt is created in the same batch; see the
      // creditedBattles rule, which requires this same pendingBattleId.
      function bid() { return u().pendingBattleId; }
      function validSettle() {
        return u().get('pendingBattleId', null) != null
            && creditableBattle(bid(), userId)
            && touched().hasOnly([
                 'pendingBattleId', 'wins', 'losses', 'draws', 'humanWins',
                 'xp', 'coins', 'totalReps', 'battlesPlayed', 'bestScore'])
            && nu().pendingBattleId == null
            && bumped('battlesPlayed', 1)
            && bumped('xp', xpAward(bid(), userId))
            // The personal-best bonus rides on the same comparison the
            // bestScore ratchet below already makes, so it costs no extra read.
            && bumped('coins', coinAward(bid(), userId)
                             + (repsOf(bid(), userId) > was('bestScore')
                                  ? prBonus() : 0))
            && bumped('totalReps', repsOf(bid(), userId))
            && bumped('wins',   drawnBy(bid()) ? 0 : (wonBy(bid(), userId) ? 1 : 0))
            && bumped('losses', drawnBy(bid()) ? 0 : (wonBy(bid(), userId) ? 0 : 1))
            && bumped('draws',  drawnBy(bid()) ? 1 : 0)
            /*
             * The counter the world ranking is built on.
             *
             * A bot battle credits XP, coins and a `wins` increment — the
             * player earned those. But the bot is driven by that same player's
             * browser, so its score is forgeable, and a ranking built on `wins`
             * would be too. `humanWins` only ever moves when the opponent is a
             * real account, and the leaderboard orders on it.
             *
             * Tested against player2 rather than a second botLevel lookup:
             * `battleOf()` is memoised per evaluation, but each extra field
             * access still counts toward Firestore's 1000-expression budget,
             * and this rule was already close enough to it to start failing.
             */
            && bumped('humanWins', humanWinOf(bid(), userId) ? 1 : 0)
            // A personal best only ever ratchets upward.
            && now_('bestScore') == (repsOf(bid(), userId) > was('bestScore')
                                       ? repsOf(bid(), userId)
                                       : was('bestScore'));
      }

      // Drop a stuck claim without paying it out, so a client that died between
      // the two phases is not wedged forever.
      function validAbandonClaim() {
        return touched().hasOnly(['pendingBattleId'])
            && nu().pendingBattleId == null;
      }

      // ---------------- daily streak bonus ----------------
      // Two phases, for the same reason the battle payout has two: rules cannot
      // see sibling writes in a batch, so the receipt must already be committed
      // when the counters move.
      //
      //   phase 1  create users/{uid}/dailyBonus/{k}  — proves the day and the
      //            three battles, and stamps `at` with the server clock
      //   phase 2  bump coins/streak here, against that committed receipt
      //
      // Ordering them this way means a client that dies between the two has
      // written a receipt it was entitled to and simply has not been paid; it
      // can retry. The reverse order would pay first and prove later.
      //
      // The receipt id is `bonusCount`, which only ever increments — NOT the
      // streak, which resets. Keying receipts by streak would make day 1 of a
      // second streak collide with day 1 of the first, locking a player out of
      // the bonus permanently once their first streak broke.
      function nextCount()  { return now_('bonusCount'); }
      function nextStreak() { return now_('streak'); }
      function bonusReceipt(k) {
        return /databases/$(database)/documents/users/$(userId)/dailyBonus/$(string(k));
      }
      function validDailyBonus() {
        return touched().hasOnly(['coins', 'streak', 'bonusCount', 'lastBonusAt'])
            && nextStreak() is int
            && nextStreak() > 0
            && bumped('bonusCount', 1)
            // The streak either advances by one or restarts at 1. It can never
            // jump, so no client can buy a 7-day payout on its first day.
            && (nextStreak() == was('streak') + 1 || nextStreak() == 1)
            // The amount is recomputed here, never taken from the client.
            && bumped('coins', streakBonus(nextStreak()))
            // Pins the payout to the receipt: the receipt names the streak it
            // is paying, so the two cannot disagree, and its `at` was already
            // forced to the server clock by the receipt's own rule.
            && exists(bonusReceipt(nextCount()))
            && get(bonusReceipt(nextCount())).data.streak == nextStreak()
            && nu().lastBonusAt == get(bonusReceipt(nextCount())).data.at;
      }

      allow update: if isSelf()
                    // subscription joins role here: written ONLY by the
                    // Stripe webhook through the Admin SDK, which bypasses
                    // rules. No client path may touch it, so no client can
                    // grant itself a paid plan or extend one.
                    // referredBy and partnerId join role and subscription:
                    // they decide who gets paid a commission, so a client that
                    // could write them could redirect someone else's money.
                    // Written server-side only, via /api/referral.
                    // username joins the server-only set: see
                    // validProfileUpdate() for why the client cannot be
                    // trusted with it. accountType too — 'pro' is granted by
                    // an admin approving an application, never self-declared.
                    && !touched().hasAny(['role', 'email', 'level', 'createdAt',
                                          'subscription', 'referredBy',
                                          'partnerId', 'referredAt',
                                          'username'])
                    && (
                         validProfileUpdate()
                      || validOnboarding()
                      || validClaim()
                      || validSettle()
                      || validAbandonClaim()
                      || validDailyBonus()
                    );

      allow delete: if false;

      // Email and anything else personal lives here: readable only by its
      // owner, and a subcollection is only listable per-parent, so it can never
      // be swept up by a leaderboard query over /users.
      // Personal details live here rather than on the profile, because
      // users/{uid} is listable by every signed-in account for the leaderboard
      // — age, weight and city on that document would be harvestable in a
      // single query.
      match /private/{docId} {
        allow read: if isSelf();

        // `contact` holds the email and is written by ensureProfile; `profile`
        // holds the optional body data. Bounds mirror onboarding.ts.
        allow write: if isSelf()
                     && (docId != 'profile' || (
                          request.resource.data.keys().hasOnly(
                            ['birthYear', 'heightCm', 'weightKg', 'gender', 'city'])
                       && (!('birthYear' in request.resource.data)
                            || (request.resource.data.birthYear is int
                             && request.resource.data.birthYear >= birthYearMin()))
                       && (!('heightCm' in request.resource.data)
                            || (request.resource.data.heightCm is int
                             && request.resource.data.heightCm >= heightMinCm()
                             && request.resource.data.heightCm <= heightMaxCm()))
                       && (!('weightKg' in request.resource.data)
                            || (request.resource.data.weightKg is int
                             && request.resource.data.weightKg >= weightMinKg()
                             && request.resource.data.weightKg <= weightMaxKg()))
                       && (!('gender' in request.resource.data)
                            || request.resource.data.gender
                                 in ['f', 'm', 'other', 'unspecified'])
                       && (!('city' in request.resource.data)
                            || (request.resource.data.city is string
                             && request.resource.data.city.size() <= cityMax()))
                     ));
      }

      // Payout receipts. Immutable once written — that immutability IS the
      // double-credit guard.
      match /creditedBattles/{battleId} {
        allow read: if isSelf();
        allow create: if isSelf()
                      // Only for the battle the parent document has claimed.
                      && get(/databases/$(database)/documents/users/$(userId))
                           .data.get('pendingBattleId', null) == battleId
                      && request.resource.data.keys().hasOnly(['at'])
                      && request.resource.data.at == request.time;
        allow update, delete: if false;
      }

      // Daily streak receipts, one per consecutive day. Immutable, exactly like
      // creditedBattles: the document's existence IS the "already claimed today"
      // memory that rules otherwise lack.
      //
      // The id is the parent's bonusCount, which never resets. Claiming the same
      // day twice is therefore a duplicate create and fails on its own, and a
      // restarted streak gets a fresh id instead of colliding with its own past.
      match /dailyBonus/{k} {
        function me()   { return get(/databases/$(database)/documents/users/$(userId)).data; }
        function first(){ return int(k) == 1; }
        function prev() {
          return get(/databases/$(database)/documents/users/$(userId)/dailyBonus/$(string(int(k) - 1))).data;
        }
        function prevExists() {
          return exists(/databases/$(database)/documents/users/$(userId)/dailyBonus/$(string(int(k) - 1)));
        }
        function d() { return request.resource.data; }

        // Has the previous claim aged out of the window in which a streak can
        // still be continued?
        function streakDead() {
          return request.time > prev().at + duration.value(streakGraceSecs(), 's');
        }

        // A battle only counts if it really concluded, really involved this
        // player, and happened AFTER the previous bonus — otherwise one good
        // day could be replayed over and over to farm a streak.
        function counts(bid) {
          return creditableBattle(bid, userId)
              && battleOf(bid).endedAt != null
              && (first() || battleOf(bid).endedAt > prev().at);
        }

        allow read: if isSelf();

        allow create: if isSelf()
                      // Receipts are consecutive: this must be the parent's
                      // next count, so none can be skipped or backfilled.
                      && int(k) == me().get('bonusCount', 0) + 1
                      && d().keys().hasOnly(['at', 'streak', 'b1', 'b2', 'b3'])
                      && d().streak is int
                      && d().streak >= 1
                      // Server clock, not the client's word.
                      && d().at == request.time
                      // The declared streak must match what the elapsed time
                      // actually permits: continue only inside the window, and
                      // restart at 1 once the grace period has passed.
                      && (first()
                            ? d().streak == 1
                            : (prevExists()
                                 // One claim per window: no claiming twice a day.
                                 && request.time >= prev().at + duration.value(streakWindowSecs(), 's')
                                 && d().streak == (streakDead() ? 1 : prev().streak + 1)))
                      // Three DISTINCT battles: the daily objective.
                      && d().b1 != d().b2 && d().b2 != d().b3 && d().b1 != d().b3
                      && counts(d().b1) && counts(d().b2) && counts(d().b3);

        allow update, delete: if false;
      }

      // Private scratch space for the clock probe.
      match /clock/{docId} {
        allow read, write: if isSelf();
      }
    }

    // ===============================================================
    // USERNAMES — uniqueness locks. The document id is the lowercased name.
    // ===============================================================
    match /usernames/{key} {
      // Readable so the account screen can report "already taken" before the
      // user submits. Holds a uid and nothing else.
      allow get, list: if signedIn();

      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['uid'])
                    && request.resource.data.uid == request.auth.uid
                    && key.matches('^[a-z][a-z0-9_]{2,15}$');

      // Never reassigned in place: releasing and claiming are separate writes
      // inside one transaction, so a lock is only ever taken when truly free.
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /battles/{battleId} {
      function d()  { return resource.data; }
      function n()  { return request.resource.data; }
      function st() { return resource.data.status; }

      function isP1() {
        return signedIn() && request.auth.uid == d().player1;
      }
      function isP2() {
        return signedIn() && d().player2 != null
            && request.auth.uid == d().player2;
      }
      function isPlayer() { return isP1() || isP2(); }

      function onlyTouches(allowed) {
        return n().diff(d()).affectedKeys().hasOnly(allowed);
      }

      // ---- derived instants, all evaluated against the SERVER clock ----
      function goInstant() {
        return d().startedAt + duration.value(countdownSecs(), 's');
      }
      function hardEnd() {
        return goInstant() + duration.value(d().durationSecs, 's');
      }
      // Scores accepted from GO until shortly after the hard end, so a final
      // flush in flight when the timer expires is not lost.
      function withinScoreWindow() {
        return d().startedAt != null
            && request.time >= goInstant() - duration.value(1, 's')
            && request.time <= hardEnd() + duration.value(scoreGraceSecs(), 's');
      }
      function pastHardEnd() {
        return d().startedAt != null
            && request.time >= hardEnd() + duration.value(finishSlackSecs(), 's');
      }
      function p1Stale() {
        return d().player1HeartbeatAt == null
            || request.time > d().player1HeartbeatAt
                              + duration.value(staleSecs(), 's');
      }

      // Anyone signed in may read a battle: spectating and joining by code
      // both require it.
      allow read: if signedIn();

      // ---------------- CREATE ----------------
      // The creator is always player1 and starts alone with a zeroed board.
      //
      // There is no share code: entry is random matchmaking, which addresses
      // battles by document id, so a guessable 6-char handle would only be an
      // enumeration surface with no user-facing purpose. hasAll (not hasOnly)
      // means a stale cached client still sending `code` is not broken by this
      // deploy.
      allow create: if signedIn()
        && n().keys().hasAll([
             'exercise', 'durationSecs', 'status',
             'player1', 'player2', 'players',
             'player1Ready', 'player2Ready',
             'player1Score', 'player2Score',
             'player1Final', 'player2Final',
             'player1Meta', 'player2Meta',
             'player1HeartbeatAt', 'player2HeartbeatAt',
             'winner', 'endReason',
             'createdAt', 'startedAt', 'endedAt'])
        && n().player1 == request.auth.uid
        && n().player2 == null
        && n().players == [request.auth.uid]
        && n().status == 'waiting'
        // The creator may stamp its OWN heartbeat here, and must: matchmaking
        // filters candidates on heartbeat freshness, so a battle created with
        // a null heartbeat is invisible to every other searcher until the
        // battle screen mounts. It has no business stamping the opponent's.
        && n().player1HeartbeatAt == request.time
        && n().player2HeartbeatAt == null
        && n().exercise is string
        && n().durationSecs is int
        && n().durationSecs > 0 && n().durationSecs <= 600
        && n().player1Ready == false && n().player2Ready == false
        && n().player1Score == 0 && n().player2Score == 0
        && n().player1Final == false && n().player2Final == false
        && n().winner == null
        && n().endReason == null
        && n().createdAt == request.time
        && n().startedAt == null
        && n().endedAt == null
        // A bot battle declares itself at birth. Write-once by construction:
        // no update rule touches botLevel, so an ordinary battle can never be
        // converted into one to unlock the opponent's seat.
        && (!('botLevel' in n())
              || n().botLevel in ['easy', 'normal', 'hard']);

      /**
       * A training battle against a bot.
       *
       * `botLevel` is set at creation and never changes; there is no rule that
       * writes it after the fact, so a battle cannot become a bot battle once
       * a human has joined it.
       */
      function isBotBattle() { return d().get('botLevel', null) != null; }

      /**
       * The human seat in a bot battle.
       *
       * The bot has no account, so its opponent's browser writes both sides.
       * That is a deliberate, contained concession: it means the bot's score is
       * forgeable, which is exactly why bot wins never reach the world ranking
       * (see humanWins in validSettle).
       */
      function drivesBot() { return isBotBattle() && isP1(); }

      // ---------------- JOIN ----------------
      // Compare-and-swap on player2. Rules are evaluated against the committed
      // pre-image inside the commit, so two concurrent joiners serialize and
      // the second sees a non-null player2 and is denied. This ALONE prevents
      // a third player; the client transaction only buys a clean error message.
      function validJoin() {
        return signedIn()
          && st() == 'waiting'
          && d().player2 == null
          && request.auth.uid != d().player1
          && n().player2 == request.auth.uid
          && n().players == [d().player1, request.auth.uid]
          && n().status == 'ready'
          && onlyTouches(['player2', 'players', 'status', 'player2HeartbeatAt']);
      }

      /**
       * Seating the bot. Only the creator of a bot battle may do it, and only
       * with the reserved uid — so this cannot be used to seat a real account
       * that never consented, nor to hijack an ordinary battle.
       */
      function validBotJoin() {
        return isBotBattle()
          && st() == 'waiting'
          && d().player2 == null
          && isP1()
          && n().player2 == 'bot'
          && n().players == [d().player1, 'bot']
          && n().status == 'ready'
          && onlyTouches(['player2', 'players', 'status']);
      }

      // ---------------- READY TOGGLES ----------------
      function validReady() {
        return st() in ['waiting', 'ready']
          && d().startedAt == null
          && heartbeatsHonest()
          && (
               (onlyTouches(['player1Ready', 'player1HeartbeatAt'])
                       && isP1() && n().player1Ready is bool)
            || (onlyTouches(['player2Ready', 'player2HeartbeatAt'])
                       && (isP2() || drivesBot())
                       && n().player2Ready is bool)
             );
      }

      // ---------------- START ----------------
      // startedAt is write-once and must be the server's own clock, so a client
      // can neither backdate nor extend the effort window. Normally only
      // player1 arms the battle; player2 may take over only once player1's
      // server-stamped heartbeat has gone stale (captaincy handover). Both
      // sides of that comparison are server-written, so it cannot be faked.
      function validStart() {
        return st() in ['waiting', 'ready']
          && d().startedAt == null
          && d().player2 != null
          && d().player1Ready == true && d().player2Ready == true
          && n().status == 'live'
          && n().startedAt == request.time
          && heartbeatsHonest()
          && onlyTouches(['status', 'startedAt',
                          'player1HeartbeatAt', 'player2HeartbeatAt'])
          && ( isP1() || (isP2() && p1Stale()) );
      }

      // ---------------- SCORES ----------------
      // Monotonic, capped, and rate-limited per write. Monotonicity is exactly
      // why the manual "-1" correction adjusts a LOCAL count and never writes a
      // decrease: the client only ever flushes its running maximum.
      function scoreOk(oldV, newV) {
        return newV is int
            && newV >= oldV
            && newV <= maxScore()
            && newV - oldV <= maxJump();
      }
      // Provenance must add up, so a client cannot claim camera-verified reps
      // it never produced.
      function metaOk(meta, total) {
        return meta.keys().hasOnly(['autoReps', 'manualAdjust', 'source'])
            && meta.autoReps is int && meta.autoReps >= 0
            && meta.manualAdjust is int
            && meta.source in ['camera', 'manual']
            && meta.autoReps + meta.manualAdjust == total;
      }

      function validScore() {
        return st() == 'live'
          && withinScoreWindow()
          && (
               (onlyTouches(['player1Score', 'player1Final',
                             'player1Meta', 'player1HeartbeatAt'])
                 && isP1()
                 && scoreOk(d().player1Score, n().player1Score)
                 && n().player1Final is bool
                 && d().player1Final == false   // the final flush latches once
                 && metaOk(n().player1Meta, n().player1Score))
            // Player 2's score: written by player 2, or by player 1 when the
            // opponent is a bot. Identical checks either way.
            //
            // The field test comes FIRST deliberately. Firestore caps a request
            // at 1000 evaluated expressions, and putting the identity checks
            // ahead of it spent the budget re-reading the document on every
            // branch — the bot's write was denied with what looks exactly like
            // a permissions bug. Cheapest discriminator first, and && short
            // circuits the rest.
            || (onlyTouches(['player2Score', 'player2Final',
                             'player2Meta', 'player2HeartbeatAt'])
                 && (isP2() || drivesBot())
                 && scoreOk(d().player2Score, n().player2Score)
                 && n().player2Final is bool
                 && d().player2Final == false
                 && metaOk(n().player2Meta, n().player2Score))
             );
      }

      // ---------------- HEARTBEAT ----------------
      // A heartbeat may only ever carry the server's own clock. This is
      // asserted on EVERY path that is allowed to touch the field, not just
      // validHeartbeat(): matchmaking ranks candidates by heartbeat freshness,
      // so a client able to forge one could pin a dead battle at the top of
      // the pool forever.
      function hbUntouchedOrServerStamped(field) {
        return !(field in n().diff(d()).affectedKeys())
            || n()[field] == request.time;
      }
      function heartbeatsHonest() {
        return hbUntouchedOrServerStamped('player1HeartbeatAt')
            && hbUntouchedOrServerStamped('player2HeartbeatAt');
      }

      function validHeartbeat() {
        return st() in ['waiting', 'ready', 'live']
          && (
               (isP1() && onlyTouches(['player1HeartbeatAt'])
                       && n().player1HeartbeatAt == request.time)
            || (isP2() && onlyTouches(['player2HeartbeatAt'])
                       && n().player2HeartbeatAt == request.time)
             );
      }

      // ---------------- WINNER ----------------
      // The client computes the winner for display, but this rule RECOMPUTES it
      // from the committed scores and rejects any mismatch. Combined with
      // own-field-only, monotonic, capped scores, the pair (score, winner) is
      // defensible without a line of server code: a client cannot nominate
      // itself the winner of a match it lost.
      function correctWinner() {
        return d().player1Score > d().player2Score
                 ? n().winner == d().player1
             : d().player2Score > d().player1Score
                 ? n().winner == d().player2
                 : n().winner == 'draw';
      }

      // ---------------- FINISH ----------------
      // Time-gated against the SERVER clock: a client that lies about the time
      // still cannot end the battle early and freeze a lead.
      function validFinish() {
        return st() == 'live'
          && pastHardEnd()
          && n().status == 'finished'
          && n().endedAt == request.time
          && n().endReason in ['time', 'forfeit']
          && correctWinner()
          && onlyTouches(['status', 'endedAt', 'endReason', 'winner'])
          && (
               isPlayer()
               // Long after both players vanished, any signed-in reader may
               // finalize a stranded battle. Safe precisely because the winner
               // is recomputed above — a stranger cannot forge the outcome.
            || request.time > hardEnd() + duration.value(staleLiveSecs(), 's')
             );
      }

      // ---------------- CANCEL ----------------
      // A player may cancel before the battle starts; anyone may reap a battle
      // abandoned in 'waiting' for an hour.
      function validCancel() {
        return st() in ['waiting', 'ready']
          && d().startedAt == null
          && n().status == 'cancelled'
          && onlyTouches(['status', 'endedAt', 'endReason'])
          && n().endReason == 'abandoned'
          && n().endedAt == request.time
          && ( isPlayer()
            || request.time > d().createdAt
                              + duration.value(abandonWaitSecs(), 's') );
      }

      /*
       * Ordered by frequency, and that ordering is load-bearing.
       *
       * Firestore evaluates the branches in sequence until one matches, with a
       * hard ceiling of 1000 expressions for the whole request. Scores and
       * heartbeats are by far the most common writes, and with them buried
       * behind the rarer lifecycle branches the bot's score write ran out of
       * budget and was denied — a failure that looks exactly like a
       * permissions bug.
       */
      allow update: if signedIn() && (
           validScore()
        || validHeartbeat()
        || validReady()
        || validJoin()
        || validBotJoin()
        || validStart()
        || validFinish()
        || validCancel()
      );

      // Results are permanent: no rewriting history, no deleting a loss.
      allow delete: if false;
    }

    // ===============================================================
    // PRO APPLICATIONS — a request to join the partner programme
    // ===============================================================
    // Keyed by uid, so one account can only ever have one pending request.
    // Creating one grants NOTHING: an admin reviews it and creates the partner
    // separately. That curation is the cheapest fraud control available, and
    // an application must not be allowed to bypass it.
    match /partnerApplications/{uid} {
      function mine() { return signedIn() && request.auth.uid == uid; }

      allow get: if mine() || isAdmin();
      allow list: if isAdmin();

      allow create: if mine()
                    && request.resource.data.keys().hasOnly(
                         ['uid', 'kind', 'structure', 'city', 'discipline',
                          'status', 'createdAt'])
                    && request.resource.data.uid == uid
                    && request.resource.data.kind in ['gym', 'coach']
                    && request.resource.data.structure is string
                    && request.resource.data.structure.size() > 0
                    && request.resource.data.structure.size() <= 80
                    && request.resource.data.city.size() <= cityMax()
                    && request.resource.data.discipline.size() <= 120
                    // An applicant cannot approve themselves.
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt == request.time;

      // Only an admin decides. The applicant may not edit after submitting,
      // which keeps what the admin reviewed and what they approved identical.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ===============================================================
    // PARTNERS — gyms and coaches who bring paying players
    // ===============================================================
    // Readable by anyone: /p/CODE is a public landing page and has to render
    // for a visitor who is not signed in. Only non-sensitive fields live here;
    // earnings are computed from `payments`, which no client can read.
    //
    // Writable by admins only, and only through the rules — the API routes use
    // the Admin SDK, which bypasses this block entirely. The rules matter for
    // the case the routes do not cover: a client trying it directly.
    match /partners/{partnerId} {
      allow get, list: if true;
      allow create, update: if isAdmin();
      // Deactivate rather than delete: history must stay explicable.
      allow delete: if false;
    }

    // ===============================================================
    // PAYMENTS — the money ledger
    // ===============================================================
    // NO CLIENT ACCESS AT ALL, not even the account that paid. This collection
    // holds what every player pays and what every partner is owed; a partner
    // has no business reading their referrals' invoices, and a player has
    // Stripe's own receipts.
    //
    // Written exclusively by the Stripe webhook through the Admin SDK. Admins
    // read it through /api/admin/*, which verifies the role server-side.
    match /payments/{invoiceId} {
      allow read, write: if false;
    }

    // ===============================================================
    // PARTNER CODE LOCKS — uniqueness, enforced
    // ===============================================================
    //
    // One document per code, id IS the code. The same compare-and-swap trick
    // usernames/{key} uses, for the same reason: Firestore can only guarantee
    // uniqueness of a DOCUMENT ID, never of a field.
    //
    // What this prevents: partner creation used to query for a clashing code
    // and then write, so two admins creating FITPRO at the same instant both
    // succeeded. Nothing surfaced it — /api/referral and /p/[code] both resolve
    // a code with limit(1) — so one partner would quietly collect the other's
    // referrals and their commission.
    //
    // Fully closed to clients. Written only by the Admin SDK inside a
    // transaction, and no client has any business enumerating partner codes.
    match /partnerCodes/{code} {
      allow read, write: if false;
    }
  }
}
