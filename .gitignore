# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the example holds no secrets and IS the setup documentation. Without
# it a fresh deployment has no record of which variables are required.
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
firestore-debug.log
firebase-debug.log

# MediaPipe runtime — generated by scripts/setup-mediapipe.mjs on install.
# Derived from the pinned @mediapipe/tasks-vision, so committing 22MB of WASM
# would only risk it drifting out of sync with package.json.
/public/mediapipe/
/public/models/
