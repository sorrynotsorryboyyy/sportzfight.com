# Firebase Web App config — Firebase console > Project settings > Your apps > Web app
# All NEXT_PUBLIC_* values are exposed to the browser. That is expected for Firebase
# web config: these identify the project, they do not authorize access.
# Access control is enforced by firestore.rules, not by hiding these keys.

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAfJihUcYV1kiPjg86PIozEX49aigFL-uc
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sportzfight.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sportzfight
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sportzfight.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=333676149853
NEXT_PUBLIC_FIREBASE_APP_ID=1:333676149853:web:51032e2416e67c1bb1a1b4

# Local development against the Firebase emulators (npm run emu).
# When true, the keys above are ignored and no cloud project is needed.
# NEXT_PUBLIC_FIREBASE_EMULATORS=true

# ---------------------------------------------------------------------------
# Payments (optional). With ANY of these missing the shop stays in its
# "Bientôt" state and every /api route answers 503 — the site works fine
# without them. All five are required together: a checkout that succeeds while
# the webhook secret is missing would charge a card and grant nothing.
#
# Requires the Firebase BLAZE plan: the webhook writes the subscription with
# the Admin SDK, which needs a service account. Firestore, Auth and the rules
# are unchanged — only the pricing plan differs.
# ---------------------------------------------------------------------------

# Stripe > Developers > API keys
# STRIPE_SECRET_KEY=sk_test_...

# Stripe > Developers > Webhooks > your endpoint > signing secret.
# Endpoint URL: https://<your-domain>/api/webhook
# Events: customer.subscription.created / .updated / .deleted,
#         checkout.session.completed
# STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe > Products > your recurring price > price id
# STRIPE_PRICE_PREMIUM=price_...
# STRIPE_PRICE_SOUTIEN=price_...

# Firebase console > Project settings > Service accounts > Generate new
# private key. Paste the WHOLE JSON on one line. Never commit this.
# FIREBASE_SERVICE_ACCOUNT={"project_id":"...","client_email":"...","private_key":"..."}

# Canonical origin, for link previews and Stripe redirect URLs. Vercel supplies
# this automatically in production; set it only to override.
# NEXT_PUBLIC_SITE_URL=https://sportzfight.com
